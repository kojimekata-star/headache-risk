FITBIT_CLIENT_ID=your_client_id_here
FITBIT_CLIENT_SECRET=your_client_secret_here
FITBIT_REDIRECT_URI=https://kojimekata-star-headache-risk-home-xwpblk.streamlit.app

# --- マルチテナント版 ---
# 実際の設定は Streamlit の Secrets（ローカルは .streamlit/secrets.toml）に書く。値はコミットしないこと。
# ログイン（st.login）用の [auth] セクションは TOML 形式のため .env では表現できない。詳細は README.md を参照。
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=https://<APP>.streamlit.app
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_KEY=sb_secret_your_key_here
# [auth]
# redirect_uri = "https://<APP>.streamlit.app/oauth2callback"
# cookie_secret = "<ランダムな32文字以上>"
# client_id = "（GOOGLE_CLIENT_ID と同じ）"
# client_secret = "（GOOGLE_CLIENT_SECRET と同じ）"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
